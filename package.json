{
  "name": "run-output",
  "displayName": "运行输出 - 代码调试",
  "description": "code runner, run code: Python, Java, JS, PHP, Go, Rust, Swift, C, C++, C#, Lua, Dart, Shell等21种编程语言",
  "version": "1.3.0",
  "publisher": "zjq",
  "icon": "icon.png",
  "repository": {
		"type": "git",
		"url": "https://github.com/cnzjq/runner.git"
	},
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "python",
    "javascript",
    "php",
    "output",
    "print",
    "debug",
    "run code",
    "code run"
  ],
  "activationEvents": [
    "onCommand:runner.runCurrentFile",
    "onCommand:runner.runSelectedCode"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "runner.runCurrentFile",
        "title": "运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "runner.runSelectedCode",
        "title": "运行选中代码",
        "icon": "$(debug-run)"
      },
      {
        "command": "runner.stopRunningCode",
        "title": "停止运行代码",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "runner.runCurrentFile",
          "group": "navigation@1",
          "when": "editorTextFocus"
        },
        {
          "command": "runner.runSelectedCode",
          "group": "navigation@2",
          "when": "editorHasSelection"
        }
      ],
      "editor/title/run": [
        {
          "command": "runner.runCurrentFile",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "runner.runCurrentFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "runner.runSelectedCode",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "代码调试输出",
      "properties": {
        "runner.showExecutionTime": {
          "type": "boolean",
          "default": false,
          "description": "在输出中显示执行时间"
        },
        "runner.clearPreviousOutput": {
          "type": "boolean",
          "default": false,
          "description": "运行前清除之前的输出"
        },
        "runner.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "在集成终端中运行代码（而非输出通道）"
        }
      }
    }
  }
}
